#
# Session Sentinel — systemd user service
# Install: cp systemd/session-sentinel.service ~/.config/systemd/user/
#          systemctl --user daemon-reload
#          systemctl --user enable --now session-sentinel.service

[Unit]
Description=Session Sentinel — Multi-AI session health monitor
Documentation=https://github.com/hyperpolymath/session-sentinel
After=graphical-session.target dbus.service dbus.socket
Wants=dbus.service
Requires=dbus.socket
PartOf=graphical-session.target

# Crash rate limiting: allow at most 10 restarts per hour before systemd
# stops trying. This prevents a crash loop from consuming resources
# indefinitely. These directives MUST be in [Unit], not [Service].
StartLimitBurst=10
StartLimitIntervalSec=3600

# Only start if a graphical session is available (needs system tray).
# Use OR logic via separate ConditionEnvironment lines — on pure Wayland
# DISPLAY may not be set, and on X11 WAYLAND_DISPLAY is absent.
ConditionEnvironment=|DISPLAY
ConditionEnvironment=|WAYLAND_DISPLAY

[Service]
Type=notify
# Wait for D-Bus session bus to be fully ready (prevents SIGABRT race — CC-004)
ExecStartPre=/bin/sleep 3
ExecStart=%h/.local/bin/session-sentinel-tray --daemon
ExecReload=/bin/kill -HUP $MAINPID

# Self-healing: restart on failure with backoff
Restart=on-failure
RestartSec=5
RestartMaxDelaySec=300
RestartSteps=10

# Watchdog: service must ping within this interval or systemd restarts it
WatchdogSec=600

# Resource limits — don't let the monitor itself become a problem
MemoryMax=128M
CPUQuota=10%

# Graceful shutdown
TimeoutStopSec=10
KillMode=mixed
KillSignal=SIGTERM

# Environment
Environment=HOME=%h
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=SESSION_SENTINEL_CONFIG=%h/.config/session-sentinel/config.toml

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=session-sentinel

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.config/session-sentinel %h/.local/share/session-sentinel /tmp/session-sentinel /tmp
PrivateTmp=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=graphical-session.target
