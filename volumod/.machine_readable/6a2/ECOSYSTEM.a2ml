# ECOSYSTEM.a2ml — Volumod ecosystem position
[metadata]
version = "1.0"
last-updated = "2026-04-11"

[project]
name = "Volumod"
purpose = "Autonomous real-time audio volume normalization and clarity optimization for non-technical users"
role = "audio-tool"

[position-in-ecosystem]
category = "audio-processing"

[related-projects]
projects = [
  { name = "Fully autonomous operation", relationship = "No manual adjustment required; set-and-forget design." },
  { name = "Context-aware adaptation", relationship = "Time-of-day profiles, device detection, ambient noise awareness." },
  { name = "Dual deployment", relationship = "Both system tray application and browser extension from single codebase." },
  { name = "Psychophysically informed", relationship = "RMS proxy for LUFS with lookahead processing for perceptual consistency." },
  { name = "Accessibility-first", relationship = "WCAG 2.1 AA, hearing loop integration, screen reader support." },
  { name = "Privacy by design", relationship = "100% on-device processing, no cloud, no telemetry." },
]
