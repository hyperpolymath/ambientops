{
  "$schema": "https://gossamer.dev/schemas/config/v1",
  "productName": "Network Ambulance",
  "version": "1.1.0",
  "identifier": "com.hyperpolymath.network-ambulance",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "deno task dev",
    "beforeBuildCommand": "deno task build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Network Ambulance",
        "width": 1024,
        "height": 768,
        "minWidth": 800,
        "minHeight": 600,
        "maxWidth": null,
        "maxHeight": null,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true,
        "alwaysOnTop": false,
        "visible": true,
        "url": "/"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'",
      "capabilities": [
        "network",
        "shell",
        "notification",
        "tray"
      ],
      "capabilityTokens": {
        "enabled": false,
        "issuer": "gossamer-runtime",
        "ttl": 3600
      },
      "sandbox": {
        "enabled": true,
        "allowExec": true,
        "allowNetwork": true,
        "allowFilesystem": false
      }
    },
    "ipc": {
      "protocol": "json",
      "bridgeInjection": true,
      "maxMessageSize": 16777216,
      "timeout": 30000
    },
    "tray": {
      "enabled": true,
      "icon": "icons/icon.png",
      "tooltip": "Network Ambulance",
      "menuOnLeftClick": true
    }
  },
  "plugins": {
    "shell": {
      "scope": [
        {
          "name": "network-ambulance-d",
          "cmd": "bin/network-ambulance-d",
          "args": ["diagnose", "--json"],
          "sidecar": false
        },
        {
          "name": "network-ambulance-repair",
          "cmd": "bin/network-ambulance-d",
          "args": ["repair", "$TARGET", "--json"],
          "sidecar": false
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "copyright": "Copyright (c) 2026 Jonathan D.A. Jewell (hyperpolymath)",
    "license": "PMPL-1.0-or-later",
    "shortDescription": "Network diagnostics and repair tool",
    "longDescription": "Cross-platform network diagnostics and automated repair utility with formally verified components",
    "linux": {
      "desktopEntry": true,
      "category": "Utility",
      "section": "utils",
      "depends": ["iproute2", "iputils-ping", "dnsutils"],
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macos": {
      "bundleIdentifier": "com.hyperpolymath.network-ambulance",
      "minimumSystemVersion": "10.15",
      "frameworks": [],
      "entitlements": null,
      "signingIdentity": null,
      "notarization": {
        "enabled": false,
        "teamId": null
      }
    },
    "windows": {
      "webview2": "embed",
      "certificateThumbprint": null,
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": null
      }
    }
  },
  "ephapax": {
    "modules": [],
    "region": "app",
    "linearVerification": true,
    "regionBoundary": "strict",
    "preload": []
  }
}
