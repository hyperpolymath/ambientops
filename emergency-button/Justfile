# justfile - Just recipes for emergency-button (Zig 0.15.2)
# V-lang implementation is deprecated (2026-04-17).

# Default recipe
default:
    @just --list

# Build the emergency-button binary
build:
    zig build

# Run all tests (unit + integration)
test:
    zig build test

# Run module-embedded unit tests only
test-unit:
    zig build test-unit

# Run integration tests only
test-integ:
    zig build test-integ

# Smoke test in dry-run mode
run-dry:
    zig build run -- trigger --dry-run

# Format Zig sources
fmt:
    zig fmt src/zig/

# Lint — currently delegated to panic-attack in CI
lint:
    @echo "Linting via panic-attack in CI (no local lint target)"

# Clean build artifacts
clean:
    rm -rf .zig-cache zig-out
