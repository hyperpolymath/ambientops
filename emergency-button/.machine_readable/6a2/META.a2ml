# META.a2ml — Emergency Button meta-level information
[metadata]
version = "0.2.0"
last-updated = "2026-04-17"

[project-info]
license = "MPL-2.0"
author = "Jonathan D.A. Jewell (hyperpolymath)"

[architecture-decisions]
decisions = [
  { id = "ADR-001", title = "zig → Zig migration", status = "accepted", date = "2026-04-17",
    context = "Estate-wide zig ban declared 2026-04-10.",
    decision = "Port all V sources to Zig 0.15.2. Canonical impl at src/zig/. V sources retained for reference only.",
    consequences = "build.zig replaces v.mod. zig build / zig build test replace v run / v test." },
  { id = "ADR-002", title = "Symlink deduplication with recovery/emergency-room", status = "accepted", date = "2026-04-17",
    context = "recovery/emergency-room/src/ had byte-identical V sources (7 files).",
    decision = "Replace duplicates with relative symlinks. Zig files follow same pattern in src/zig/.",
    consequences = "Single source of truth in emergency-button. Deletion sequence: delete from emergency-button first." },
]

[development-practices]
versioning = "SemVer"
documentation = "AsciiDoc"
build-tool = "just + zig"
primary-language = "Zig 0.15.2"
abi-layer = "Idris2"
test-runner = "zig build test"

[maintenance-axes]
scoping-first = true
axis-1 = "must > intend > like"
axis-2 = "corrective > adaptive > perfective"
axis-3 = "systems > compliance > effects"
